#!/usr/bin/bash
read -p "Enter Your Username : " Username
echo "Your  Username is : $Username"
if [ -z $Username ]; then
   echo "Error: Username cannot be empty!"
   exit 2
error
fi
read -p "Enter your Age : " Age
echo "You are $Age years old"
if [ "$Age"  -gt 120 ]; then
   echo "Error: invalid Age!"
   exit 3
fi
if [[ "$Username" == "Admin" && "$Age" -ge 18 ]]; then
   echo "Admin Access Granted!"
else echo "normal access granted!"
fi

# Ask the user to enter a file name/path
echo "Please enter a file name/path:"
read -r filename

# 1. Check if the file does not exist
if [[ ! -e "$filename" ]]; then
    echo "Error: File not found" >&2
    exit 4
fi

# 2. Check if the file exists but is not readable
# We use -f to ensure it's a regular file first, then check readability
if [[ -f "$filename" ]] && [[ ! -r "$filename" ]]; then
    echo "Error: File not readable" >&2
    exit 5
fi

# If all checks pass, the script can continue
echo "File found and is readable!"

 #Run a command that checks for the word "ERROR" in that file using grep "-q"
grep -q "ERROR" "$FILE_PATH"

# 9. Exit code handling ($? or if grep ...; then)
# o If "ERROR" is found (grep returns success/0) → print: ERROR found in file
if [ $? -eq 0 ]; then
    echo "ERROR found in file"
# o Otherwise (grep returns failure/non-zero) → print: No ERROR found
else
    echo "No ERROR found"
fi
echo "script finished successfully!"
   exit 0
